<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"> <!-- Fixed the transparent black color -->

    <!--
        THIS IS THE NEW TUTORIAL TITLE
        It's centered horizontally and placed at the top of the screen.
    -->
    <TextView
        android:id="@+id/tv_tutorial_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="Tutorial"
        android:textAllCaps="true"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="#664EA2"
        android:textSize="24sp"
        android:textStyle="bold|italic" />

    <!-- This is the main slideshow viewer -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/tab_indicator"
        android:layout_below="@+id/tv_tutorial_title" /> <!-- Position it below the new title -->

    <!-- This is the close button, it remains in the top-right corner -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:background="@android:drawable/checkbox_off_background"
        android:contentDescription="Close Slideshow"
        app:srcCompat="@drawable/ic_close"
        app:tint="#664EA2" /> <!-- Use a solid white color -->

    <!-- This is the page indicator with the dots -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@android:color/transparent"
        app:tabBackground="@drawable/tab_selector"
        app:tabGravity="center"
        app:tabIndicatorHeight="0dp" />

</RelativeLayout>
